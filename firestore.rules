rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: profiles
// Document ID: auto-generated
// Fields (this is a prototype policy and should be reviewed before launch):
//   - id: string (required, immutable) - User's Firebase Auth UID
//   - role: string (required, immutable) - 'customer' | 'builder' | 'administrator'
//   - email: string (required, immutable for client writes) - private account email
//   - full_name: string (required, 2-100 chars) - User's full name
//   - phone: string (optional, nullable) - User's phone number
//   - avatar_path: string (optional, nullable) - Storage path to avatar
//   - district: string (optional, nullable) - User's district
//   - created_at: timestamp (required, immutable) - Creation time
//   - updated_at: timestamp (required) - Last update time
//
// Collection: builders
// Document ID: auto-generated
// Fields:
//   - profile_id: string (required, immutable) - Reference to profiles.id
//   - business_name: string (optional, nullable, 2-100 chars)
//   - bio: string (optional, nullable, max 1000 chars)
//   - years_experience: number (required, >= 0)
//   - verification_status: string (required) - 'pending' | 'verified' | 'rejected'
//   - average_rating: number (required, 0-5)
//   - completed_jobs: number (required, >= 0)
//   - response_time_minutes: number (optional, nullable, >= 0)
//   - avatar_url: string (optional, nullable) - Cloudinary photo URL
//   - service_areas: string[] (optional, <= 30) - extra districts served
//   - languages: string[] (optional, <= 10)
//   - starting_price: int (optional, nullable) - minimum charge in MWK
//   - qualifications: string (optional, nullable, max 500 chars)
//
// Collection: categories
// Document ID: auto-generated
// Fields:
//   - id: string (required, immutable)
//   - name: string (required, 2-100 chars)
//   - slug: string (required, 2-100 chars)
//   - icon: string (optional, nullable)
//
// Collection: skills
// Document ID: auto-generated
// Fields:
//   - id: string (required, immutable)
//   - category_id: string (optional, nullable) - Reference to categories.id
//   - name: string (required, 2-100 chars)
//
// Collection: builder_skills
// Document ID: auto-generated
// Fields:
//   - builder_id: string (required, immutable) - Reference to builders.profile_id
//   - skill_id: string (required, immutable) - Reference to skills.id
//
// Collection: portfolio_items
// Document ID: auto-generated
// Fields:
//   - id: string (required, immutable)
//   - builder_id: string (required, immutable) - Reference to builders.profile_id
//   - storage_path: string (required, valid URL path)
//   - caption: string (optional, nullable, max 500 chars)
//   - created_at: timestamp (required, immutable)
//
// Collection: builder_documents
// Document ID: auto-generated
// Fields:
//   - id: string (required, immutable)
//   - builder_id: string (required, immutable) - Reference to builders.profile_id
//   - type: string (required) - 'national_id' | 'certificate' | 'license'
//   - storage_path: string (required, valid URL path)
//   - review_status: string (required) - 'pending' | 'approved' | 'rejected'
//   - created_at: timestamp (required, immutable)
//
// ===============================================================

// ===============================================================
// Helper Functions
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

// Check if the user is authenticated
function isAuthenticated() {
  return request.auth != null;
}

// Check if user owns the resource (for user-owned documents)
function isOwner(userId) {
  return isAuthenticated() && request.auth.uid == userId;
}

// Verify UID hasn't been tampered with on create
function uidUnchanged() {
  return !('id' in request.resource.data) ||
    request.resource.data.id == request.auth.uid;
}

// Validate required fields exist.
function hasRequiredFields(fields) {
  return request.resource.data.keys().hasAll(fields);
}

// Ensure uid field is not modified on update
function uidNotModified() {
  return !('id' in request.resource.data) ||
    request.resource.data.id == resource.data.id;
}

// Validate required fields exist
// Validate string length
function validStringLength(field, minLen, maxLen) {
  return request.resource.data[field] is string &&
    request.resource.data[field].size() >= minLen &&
    request.resource.data[field].size() <= maxLen;
}

// Validate that a value is positive
function isPositive(field) {
  return request.resource.data[field] is number && request.resource.data[field] >= 0;
}

// Validate that the document contains only the allowed fields
function hasOnlyAllowedFields(fields) {
  return request.resource.data.keys().hasOnly(fields);
}

// Validate that the document hasn't changed in the fields that are not allowed to be changed
function areImmutableFieldsUnchanged(fields) {
  return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
}

// Validate optional string (if present, must be string and within length)
function isValidOptionalString(field, minLen, maxLen) {
  return !(field in request.resource.data) ||
         request.resource.data[field] == null ||
         (request.resource.data[field] is string &&
          request.resource.data[field].size() >= minLen &&
          request.resource.data[field].size() <= maxLen);
}

// Validate that a timestamp is a valid timestamp
function isValidTimestamp(field) {
  return request.resource.data[field] is timestamp;
}

// ===============================================================
// Domain Validators
// ===============================================================

// Validate profile document
function isValidProfile(data) {
  return hasRequiredFields(['id', 'role', 'full_name', 'email', 'created_at', 'updated_at']) &&
    hasOnlyAllowedFields(['id', 'role', 'full_name', 'phone', 'email', 'avatar_path', 'district', 'created_at', 'updated_at']) &&
    data.id is string && data.id.size() > 0 && data.id.size() < 128 &&
    data.role in ['customer', 'builder', 'administrator'] &&
    validStringLength('full_name', 2, 100) &&
    (data.email == null || (data.email is string && data.email.size() > 3 && data.email.size() <= 254)) &&
    isValidOptionalString('phone', 7, 20) &&
    isValidOptionalString('avatar_path', 1, 500) &&
    isValidOptionalString('district', 1, 100) &&
    isValidTimestamp('created_at') &&
    isValidTimestamp('updated_at');
}

// Validate builder document
function isValidBuilder(data) {
  return hasRequiredFields(['profile_id', 'years_experience', 'verification_status', 'average_rating', 'completed_jobs']) &&
    hasOnlyAllowedFields(['profile_id', 'business_name', 'bio', 'display_name', 'district', 'trades', 'years_experience', 'verification_status', 'average_rating', 'completed_jobs', 'response_time_minutes', 'response_count', 'available', 'rejection_reason',
      'rating_sum', 'review_count', 'last_review_id', 'last_completed_booking_id', 'last_response_booking_id',
      'avatar_url', 'service_areas', 'languages', 'starting_price', 'qualifications']) &&
    data.profile_id is string && data.profile_id.size() > 0 && data.profile_id.size() < 128 &&
    isValidOptionalString('business_name', 2, 100) &&
    isValidOptionalString('bio', 1, 1000) &&
    isValidOptionalString('display_name', 2, 100) &&
    isValidOptionalString('district', 1, 100) &&
    (!('trades' in data) || (data.trades is list && data.trades.size() <= 12)) &&
    isPositive('years_experience') &&
    data.verification_status in ['pending', 'verified', 'rejected'] &&
    data.average_rating is number && data.average_rating >= 0 && data.average_rating <= 5 &&
    isPositive('completed_jobs') &&
    (data.get('response_time_minutes', null) == null || (data.response_time_minutes is number && data.response_time_minutes >= 0)) &&
    (data.get('response_count', 0) is int && data.get('response_count', 0) >= 0) &&
    (data.get('review_count', 0) is int && data.get('review_count', 0) >= 0) &&
    (data.get('rating_sum', 0) is number && data.get('rating_sum', 0) >= 0) &&
    data.get('available', true) is bool &&
    isValidOptionalString('rejection_reason', 1, 500) &&
    (data.get('avatar_url', null) == null ||
      (data.avatar_url is string && data.avatar_url.size() <= 500 && data.avatar_url.matches('^https://res[.]cloudinary[.]com/.+'))) &&
    (!('service_areas' in data) || (data.service_areas is list && data.service_areas.size() <= 30)) &&
    (!('languages' in data) || (data.languages is list && data.languages.size() <= 10)) &&
    (data.get('starting_price', null) == null || (data.starting_price is int && data.starting_price >= 0 && data.starting_price <= 1000000000)) &&
    isValidOptionalString('qualifications', 1, 500);
}

// Validate category document
function isValidCategory(data) {
  return hasOnlyAllowedFields(['id', 'name', 'slug', 'icon']) &&
    data.id is string && data.id.size() > 0 && data.id.size() < 128 &&
    validStringLength('name', 2, 100) &&
    validStringLength('slug', 2, 100) &&
    isValidOptionalString('icon', 1, 500);
}

// Validate skill document
function isValidSkill(data) {
  return hasOnlyAllowedFields(['id', 'category_id', 'name']) &&
    data.id is string && data.id.size() > 0 && data.id.size() < 128 &&
    isValidOptionalString('category_id', 1, 128) &&
    validStringLength('name', 2, 100);
}

// Validate builder_skill document
function isValidBuilderSkill(data) {
  return hasOnlyAllowedFields(['builder_id', 'skill_id']) &&
    data.builder_id is string && data.builder_id.size() > 0 && data.builder_id.size() < 128 &&
    data.skill_id is string && data.skill_id.size() > 0 && data.skill_id.size() < 128;
}

// Validate portfolio item document
function isValidPortfolioItem(data) {
  return hasOnlyAllowedFields(['id', 'builder_id', 'storage_path', 'caption', 'created_at']) &&
    data.id is string && data.id.size() > 0 && data.id.size() < 128 &&
    data.builder_id is string && data.builder_id.size() > 0 && data.builder_id.size() < 128 &&
    data.storage_path is string && data.storage_path.size() > 0 && data.storage_path.size() < 500 &&
    isValidOptionalString('caption', 1, 500) &&
    isValidTimestamp('created_at');
}

// Validate builder document
function isValidBuilderDocument(data) {
  return hasOnlyAllowedFields(['id', 'builder_id', 'type', 'storage_path', 'review_status', 'created_at']) &&
    data.id is string && data.id.size() > 0 && data.id.size() < 128 &&
    data.builder_id is string && data.builder_id.size() > 0 && data.builder_id.size() < 128 &&
    data.type in ['national_id', 'certificate', 'license'] &&
    data.storage_path is string && data.storage_path.size() > 0 && data.storage_path.size() < 500 &&
    data.review_status in ['pending', 'approved', 'rejected'] &&
    isValidTimestamp('created_at');
}

// Validate booking document
function isValidBooking(data) {
  return hasRequiredFields(['customer_id', 'builder_id', 'customer_name', 'builder_name', 'service', 'preferred_date', 'location', 'description', 'status', 'created_at', 'updated_at']) &&
    hasOnlyAllowedFields(['customer_id', 'builder_id', 'customer_name', 'builder_name', 'service', 'preferred_date', 'location', 'description', 'status', 'created_at', 'updated_at', 'proposed_date', 'quote_amount', 'decline_reason', 'cancel_reason']) &&
    (data.get('proposed_date', null) == null || (data.proposed_date is string && data.proposed_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
    (data.get('quote_amount', null) == null || (data.quote_amount is int && data.quote_amount >= 0 && data.quote_amount <= 1000000000)) &&
    isValidOptionalString('decline_reason', 1, 300) &&
    isValidOptionalString('cancel_reason', 1, 300) &&
    data.customer_id is string && data.customer_id.size() > 0 && data.customer_id.size() < 128 &&
    data.builder_id is string && data.builder_id.size() > 0 && data.builder_id.size() < 128 &&
    validStringLength('customer_name', 2, 100) &&
    validStringLength('builder_name', 2, 100) &&
    validStringLength('service', 2, 100) &&
    data.preferred_date is string && data.preferred_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
    validStringLength('location', 3, 200) &&
    validStringLength('description', 10, 1000) &&
    data.status in ['pending', 'accepted', 'declined', 'cancelled', 'completed'] &&
    isValidTimestamp('created_at') &&
    isValidTimestamp('updated_at');
}

// Validate one 1-5 star rating
function isStarRating(value) {
  return value is int && value >= 1 && value <= 5;
}

// Validate review document
function isValidReview(data) {
  return hasRequiredFields(['booking_id', 'builder_id', 'customer_id', 'customer_name', 'rating', 'category_ratings', 'comment', 'created_at']) &&
    hasOnlyAllowedFields(['booking_id', 'builder_id', 'customer_id', 'customer_name', 'rating', 'category_ratings', 'comment', 'created_at']) &&
    data.booking_id is string && data.booking_id.size() > 0 && data.booking_id.size() < 128 &&
    data.builder_id is string && data.builder_id.size() > 0 && data.builder_id.size() < 128 &&
    data.customer_id is string && data.customer_id.size() > 0 && data.customer_id.size() < 128 &&
    validStringLength('customer_name', 2, 100) &&
    isStarRating(data.rating) &&
    data.category_ratings is map &&
    data.category_ratings.keys().hasAll(['communication', 'work_quality', 'time_management', 'value_for_money', 'professionalism']) &&
    data.category_ratings.keys().hasOnly(['communication', 'work_quality', 'time_management', 'value_for_money', 'professionalism']) &&
    isStarRating(data.category_ratings.communication) &&
    isStarRating(data.category_ratings.work_quality) &&
    isStarRating(data.category_ratings.time_management) &&
    isStarRating(data.category_ratings.value_for_money) &&
    isStarRating(data.category_ratings.professionalism) &&
    validStringLength('comment', 10, 1000) &&
    isValidTimestamp('created_at');
}

// Check if user is a builder (has a builder profile)
function isBuilder() {
  return isAuthenticated() &&
    exists(/databases/$(database)/documents/builders/$(request.auth.uid));
}

// Check if user is an administrator
function isAdmin() {
  return isAuthenticated() &&
    get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'administrator';
}

    // ===========================================================
    // Profiles Collection
    // Users can only read/write their own profile
    // ===========================================================
    match /profiles/{profileId} {
      allow read: if isOwner(profileId) || isAdmin();
      allow create: if isOwner(profileId) &&
        isValidProfile(request.resource.data) &&
        uidUnchanged() &&
        request.resource.data.id == request.auth.uid &&
        request.resource.data.role in ['customer', 'builder'] &&
        request.resource.data.created_at == request.time;
      allow update: if isOwner(profileId) &&
        isValidProfile(request.resource.data) &&
        uidNotModified() &&
        areImmutableFieldsUnchanged(['id', 'role', 'email', 'created_at']) &&
        request.resource.data.updated_at == request.time;
      allow delete: if false;
    }

    // ===========================================================
    // Builders Collection
    // Builders can read/write their own builder profile
    // Public can read verified builder profiles
    // ===========================================================
    match /builders/{builderId} {
      allow read: if isOwner(builderId) || isAdmin() ||
        (isAuthenticated() && resource.data.verification_status == 'verified');
      allow create: if isOwner(builderId) &&
        isValidBuilder(request.resource.data) &&
        request.resource.data.profile_id == request.auth.uid &&
        request.resource.data.verification_status == 'pending' &&
        // Stats start at zero and only change through the stat rules below.
        request.resource.data.average_rating == 0 &&
        request.resource.data.completed_jobs == 0 &&
        !request.resource.data.keys().hasAny(['response_time_minutes', 'response_count', 'rejection_reason',
          'rating_sum', 'review_count', 'last_review_id', 'last_completed_booking_id', 'last_response_booking_id']);
      allow update: if isOwner(builderId) &&
        isValidBuilder(request.resource.data) &&
        request.resource.data.profile_id == resource.data.profile_id &&
        areImmutableFieldsUnchanged(['profile_id', 'average_rating', 'completed_jobs', 'response_time_minutes', 'response_count', 'rejection_reason',
          'rating_sum', 'review_count', 'last_review_id', 'last_completed_booking_id', 'last_response_booking_id']) &&
        (request.resource.data.verification_status == resource.data.verification_status ||
         request.resource.data.verification_status == 'pending');
      // Administrators may only change a builder's verification status and the reason shown to the builder.
      allow update: if isAdmin() &&
        isValidBuilder(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verification_status', 'rejection_reason']);
      // Stats, written by the app in the same batch as the event they count.
      // Each one names the booking/review it counts, and the rules check that
      // event happens in this very write, so a stat can't be bumped on its own.
      allow update: if isOwner(builderId) && isValidBuilder(request.resource.data) &&
        (builderCompletedJob(builderId) || builderRecordedResponse(builderId));
      allow update: if isAuthenticated() && isValidBuilder(request.resource.data) && builderReviewed(builderId);
      allow delete: if false;
    }

    // Builder marks a job done: completed_jobs + 1, with the booking going accepted -> completed.
    function builderCompletedJob(builderId) {
      let data = request.resource.data;
      let id = data.get('last_completed_booking_id', '');
      let path = /databases/$(database)/documents/bookings/$(id);
      return data.diff(resource.data).affectedKeys().hasOnly(['completed_jobs', 'last_completed_booking_id']) &&
        id is string && id.size() > 0 &&
        data.completed_jobs == resource.data.completed_jobs + 1 &&
        get(path).data.builder_id == builderId &&
        get(path).data.status == 'accepted' &&
        getAfter(path).data.status == 'completed';
    }

    // Builder's first reply to a request (accept, decline or counter-offer):
    // update the running average reply time. Minutes are measured on the
    // device, so allow 15 minutes of clock difference.
    function builderRecordedResponse(builderId) {
      let data = request.resource.data;
      let id = data.get('last_response_booking_id', '');
      let path = /databases/$(database)/documents/bookings/$(id);
      let before = get(path).data;
      let after = getAfter(path).data;
      let count = resource.data.get('response_count', 0);
      let average = resource.data.get('response_time_minutes', null) == null ? 0 : resource.data.response_time_minutes;
      let minutes = (request.time.toMillis() - before.created_at.toMillis()) / 60000;
      return data.diff(resource.data).affectedKeys().hasOnly(['response_time_minutes', 'response_count', 'last_response_booking_id']) &&
        id is string && id.size() > 0 &&
        before.builder_id == builderId &&
        before.status == 'pending' && before.get('proposed_date', null) == null &&
        (after.status in ['accepted', 'declined'] || after.get('proposed_date', null) != null) &&
        data.response_count == count + 1 &&
        math.abs(data.response_time_minutes * (count + 1) - (average * count + minutes)) <= 15 + count + 1;
    }

    // Customer publishes a review: add its rating to the builder's totals.
    function builderReviewed(builderId) {
      let data = request.resource.data;
      let id = data.get('last_review_id', '');
      let path = /databases/$(database)/documents/reviews/$(id);
      let review = getAfter(path).data;
      return data.diff(resource.data).affectedKeys().hasOnly(['average_rating', 'rating_sum', 'review_count', 'last_review_id']) &&
        id is string && id.size() > 0 &&
        !exists(path) &&
        review.builder_id == builderId &&
        review.customer_id == request.auth.uid &&
        data.review_count == resource.data.get('review_count', 0) + 1 &&
        data.rating_sum == resource.data.get('rating_sum', 0) + review.rating &&
        math.abs(data.average_rating - data.rating_sum / data.review_count) <= 0.05;
    }

    // ===========================================================
    // Categories Collection
    // Readable by all authenticated users
    // Only administrators can write
    // ===========================================================
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidCategory(request.resource.data);
      allow update: if isAdmin() && isValidCategory(request.resource.data) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if isAdmin();
    }

    // ===========================================================
    // Skills Collection
    // Readable by all authenticated users
    // Only administrators can write
    // ===========================================================
    match /skills/{skillId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidSkill(request.resource.data);
      allow update: if isAdmin() && isValidSkill(request.resource.data) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if isAdmin();
    }

    // ===========================================================
    // Builder Skills Collection
    // Builders can manage their own skills
    // ===========================================================
    match /builder_skills/{builderSkillId} {
      allow read: if isAuthenticated();
      allow create: if isBuilder() &&
        isValidBuilderSkill(request.resource.data) &&
        request.resource.data.builder_id == request.auth.uid;
      allow update: if false;
      allow delete: if isBuilder() &&
        resource.data.builder_id == request.auth.uid;
    }

    // ===========================================================
    // Portfolio Items Collection
    // Builders can manage their own portfolio items
    // ===========================================================
    match /portfolio_items/{portfolioItemId} {
      allow read: if isAuthenticated();
      allow create: if isBuilder() &&
        isValidPortfolioItem(request.resource.data) &&
        request.resource.data.builder_id == request.auth.uid &&
        request.resource.data.created_at == request.time;
      allow update: if isBuilder() &&
        resource.data.builder_id == request.auth.uid &&
        isValidPortfolioItem(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'builder_id', 'created_at']);
      allow delete: if isBuilder() &&
        resource.data.builder_id == request.auth.uid;
    }

    // ===========================================================
    // Builder Documents Collection
    // Builders can manage their own documents
    // Only administrators can change review status
    // ===========================================================
    match /builder_documents/{builderDocumentId} {
      allow read: if isOwner(resource.data.builder_id) || isAdmin();
      allow create: if isBuilder() &&
        isValidBuilderDocument(request.resource.data) &&
        request.resource.data.builder_id == request.auth.uid &&
        request.resource.data.review_status == 'pending' &&
        request.resource.data.created_at == request.time;
      allow update: if (isBuilder() &&
        resource.data.builder_id == request.auth.uid &&
        isValidBuilderDocument(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'builder_id', 'type', 'storage_path', 'created_at']) &&
        request.resource.data.review_status == resource.data.review_status) ||
        (isAdmin() &&
        isValidBuilderDocument(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'builder_id', 'type', 'storage_path', 'created_at']));
      allow delete: if isBuilder() &&
        resource.data.builder_id == request.auth.uid;
    }

    // ===========================================================
    // Bookings Collection
    // A customer sends a request to a verified, available builder.
    // Only the two parties (and administrators) can read it. After
    // creation only these changes are allowed:
    //   builder:  pending -> accepted (optional quote)
    //             pending -> declined (optional reason)
    //             pending -> pending  (propose another date, optional quote)
    //             accepted -> completed
    //   customer: pending | accepted -> cancelled (optional reason)
    //             pending with a proposed date -> accepted on that date
    // ===========================================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (resource.data.customer_id == request.auth.uid ||
         resource.data.builder_id == request.auth.uid ||
         isAdmin());
      allow create: if isAuthenticated() &&
        isValidBooking(request.resource.data) &&
        request.resource.data.customer_id == request.auth.uid &&
        request.resource.data.builder_id != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        !request.resource.data.keys().hasAny(['proposed_date', 'quote_amount', 'decline_reason', 'cancel_reason']) &&
        request.resource.data.created_at == request.time &&
        request.resource.data.updated_at == request.time &&
        request.resource.data.customer_name ==
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.full_name &&
        get(/databases/$(database)/documents/builders/$(request.resource.data.builder_id)).data.verification_status == 'verified' &&
        get(/databases/$(database)/documents/builders/$(request.resource.data.builder_id)).data.get('available', true) == true;
      allow update: if isAuthenticated() &&
        isValidBooking(request.resource.data) &&
        request.resource.data.updated_at == request.time &&
        (bookingBuilderUpdate() || bookingCustomerUpdate());
      allow delete: if false;

      // Chat between the two parties while the job is open.
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isBookingParty(bookingId);
        allow create: if isAuthenticated() &&
          isBookingParty(bookingId) &&
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.status in ['pending', 'accepted'] &&
          hasRequiredFields(['sender_id', 'text', 'created_at']) &&
          hasOnlyAllowedFields(['sender_id', 'text', 'image_url', 'created_at']) &&
          request.resource.data.sender_id == request.auth.uid &&
          validStringLength('text', 0, 1000) &&
          // A message is text, a photo, or a photo with a caption. Photos
          // must be Cloudinary uploads, so links can't point elsewhere.
          (request.resource.data.text.size() > 0 || 'image_url' in request.resource.data) &&
          (!('image_url' in request.resource.data) ||
            (request.resource.data.image_url is string &&
             request.resource.data.image_url.size() <= 500 &&
             request.resource.data.image_url.matches('^https://res[.]cloudinary[.]com/.+'))) &&
          request.resource.data.created_at == request.time;
        allow update, delete: if false;
      }
    }

    // ===========================================================
    // Conversations (inbox summary, one per booking with messages)
    // Written by the app in the same batch as each message. The rules
    // check the summary matches the booking, the sender, and that the
    // other party's unread count goes up by exactly one. Either party
    // may also mark it read for themselves, or copy the booking's
    // current status onto it after changing the booking.
    // ===========================================================
    match /conversations/{bookingId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() &&
        hasOnlyAllowedFields(['participants', 'customer_id', 'builder_id', 'customer_name', 'builder_name', 'service',
          'status', 'last_message', 'last_sender_id', 'last_message_at', 'unread']) &&
        conversationMatchesBooking(bookingId) &&
        isNewMessageSummary(bookingId, 0);
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants && (
          // A new message.
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'last_message', 'last_sender_id', 'last_message_at', 'unread']) &&
            conversationMatchesBooking(bookingId) &&
            isNewMessageSummary(bookingId, resource.data.unread.get(otherPartyOf(bookingOf(bookingId)), 0))) ||
          // Marking it read.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread', 'read_at']) &&
            request.resource.data.unread.diff(resource.data.unread).affectedKeys().hasOnly([request.auth.uid]) &&
            request.resource.data.unread[request.auth.uid] == 0 &&
            request.resource.data.get('read_at', {}).diff(resource.data.get('read_at', {})).affectedKeys().hasOnly([request.auth.uid]) &&
            request.resource.data.read_at[request.auth.uid] == request.time) ||
          // Booking status changed.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            request.resource.data.status == bookingOf(bookingId).status)
        );
      allow delete: if false;
    }

    function bookingOf(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    function otherPartyOf(booking) {
      return booking.customer_id == request.auth.uid ? booking.builder_id : booking.customer_id;
    }

    function conversationMatchesBooking(bookingId) {
      let booking = bookingOf(bookingId);
      let data = request.resource.data;
      return (booking.customer_id == request.auth.uid || booking.builder_id == request.auth.uid) &&
        data.participants == [booking.customer_id, booking.builder_id] &&
        data.customer_id == booking.customer_id &&
        data.builder_id == booking.builder_id &&
        data.customer_name == booking.customer_name &&
        data.builder_name == booking.builder_name &&
        data['service'] == booking['service'] && // `service` is a reserved word in rules

        data.status == booking.status;
    }

    function isNewMessageSummary(bookingId, previousUnread) {
      let booking = bookingOf(bookingId);
      let data = request.resource.data;
      let other = otherPartyOf(booking);
      return booking.status in ['pending', 'accepted'] &&
        data.last_sender_id == request.auth.uid &&
        data.last_message is string && data.last_message.size() > 0 && data.last_message.size() <= 140 &&
        data.last_message_at == request.time &&
        data.unread is map &&
        data.unread.keys().hasOnly([booking.customer_id, booking.builder_id]) &&
        data.unread[other] == previousUnread + 1 &&
        data.unread[request.auth.uid] == 0;
    }

    // ===========================================================
    // Contacts: "<me>_<other>" exists once two people share a
    // booking. It lets the app read the other person's push tokens
    // to notify them, and nobody else's.
    // ===========================================================
    match /contacts/{contactId} {
      allow read: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
      allow create, update: if isAuthenticated() &&
        hasOnlyAllowedFields(['owner_id', 'contact_id', 'booking_id', 'updated_at']) &&
        request.resource.data.owner_id == request.auth.uid &&
        request.resource.data.contact_id is string &&
        contactId == request.auth.uid + '_' + request.resource.data.contact_id &&
        request.resource.data.booking_id is string &&
        request.resource.data.updated_at == request.time &&
        sharesBooking(request.resource.data.booking_id, request.auth.uid, request.resource.data.contact_id);
      allow delete: if false;
    }

    function sharesBooking(bookingId, first, second) {
      let booking = bookingOf(bookingId);
      return (booking.customer_id == first && booking.builder_id == second) ||
        (booking.customer_id == second && booking.builder_id == first);
    }

    function isBookingParty(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return booking.customer_id == request.auth.uid || booking.builder_id == request.auth.uid;
    }

    function bookingChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function bookingBuilderUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return before.builder_id == request.auth.uid && (
        (before.status == 'pending' && after.status == 'accepted' &&
          bookingChanged(['status', 'updated_at', 'quote_amount', 'proposed_date']) &&
          after.get('proposed_date', null) == null) ||
        (before.status == 'pending' && after.status == 'declined' &&
          bookingChanged(['status', 'updated_at', 'decline_reason', 'proposed_date']) &&
          after.get('proposed_date', null) == null) ||
        (before.status == 'pending' && after.status == 'pending' &&
          bookingChanged(['updated_at', 'proposed_date', 'quote_amount']) &&
          after.get('proposed_date', null) != null) ||
        (before.status == 'accepted' && after.status == 'completed' &&
          bookingChanged(['status', 'updated_at']))
      );
    }

    function bookingCustomerUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return before.customer_id == request.auth.uid && (
        (before.status in ['pending', 'accepted'] && after.status == 'cancelled' &&
          bookingChanged(['status', 'updated_at', 'cancel_reason'])) ||
        // Agreeing to the builder's proposed date accepts the booking on that date.
        (before.status == 'pending' && before.get('proposed_date', null) != null &&
          after.status == 'accepted' &&
          after.preferred_date == before.proposed_date &&
          after.get('proposed_date', null) == null &&
          bookingChanged(['status', 'updated_at', 'preferred_date', 'proposed_date']))
      );
    }

    // ===========================================================
    // Reviews Collection
    // Public to signed-in users. The document id is the booking id,
    // so each booking can be reviewed once, and only by its customer
    // after the builder has marked the job completed. Reviews are
    // permanent; administrators can remove abusive ones.
    // ===========================================================
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isValidReview(request.resource.data) &&
        request.resource.data.booking_id == reviewId &&
        request.resource.data.customer_id == request.auth.uid &&
        request.resource.data.created_at == request.time &&
        get(/databases/$(database)/documents/bookings/$(reviewId)).data.customer_id == request.auth.uid &&
        get(/databases/$(database)/documents/bookings/$(reviewId)).data.status == 'completed' &&
        get(/databases/$(database)/documents/bookings/$(reviewId)).data.builder_id == request.resource.data.builder_id &&
        get(/databases/$(database)/documents/bookings/$(reviewId)).data.customer_name == request.resource.data.customer_name;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===========================================================
    // Favorites Collection
    // A user's private list of saved builders. Document id is
    // "{userId}_{builderId}"; only the owner can read or change it.
    // ===========================================================
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() &&
        hasRequiredFields(['user_id', 'builder_id', 'created_at']) &&
        hasOnlyAllowedFields(['user_id', 'builder_id', 'created_at']) &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.builder_id is string &&
        request.resource.data.builder_id.size() > 0 && request.resource.data.builder_id.size() < 128 &&
        favoriteId == request.auth.uid + '_' + request.resource.data.builder_id &&
        request.resource.data.created_at == request.time;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // ===========================================================
    // Push Tokens Collection
    // Expo push tokens for a user's devices, keyed by user id.
    // Read by the owner, and by people they share a booking with
    // (see contacts) so the app can send them a notification.
    // ===========================================================
    match /push_tokens/{userId} {
      allow read: if isOwner(userId);
      allow get: if isAuthenticated() &&
        exists(/databases/$(database)/documents/contacts/$(request.auth.uid + '_' + userId));
      allow create, update: if isOwner(userId) &&
        hasRequiredFields(['tokens', 'updated_at']) &&
        hasOnlyAllowedFields(['tokens', 'updated_at']) &&
        request.resource.data.tokens is list &&
        request.resource.data.tokens.size() <= 10 &&
        request.resource.data.updated_at == request.time;
      allow delete: if isOwner(userId);
    }
  }
}
