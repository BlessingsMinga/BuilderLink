[debug] [2026-08-03T12:25:41.596Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/builderlink-cd7d0/rulesets {"name":"projects/builderlink-cd7d0/rulesets/dbd6abb9-8129-47b9-a54b-5d64d8221cf1","source":{"files":[{"content":"rules_version = '2';\r\n\r\n// ===============================================================\r\n// Assumed Data Model\r\n// ===============================================================\r\n//\r\n// This security rules file assumes the following data structures:\r\n//\r\n// Collection: profiles\r\n// Document ID: auto-generated\r\n// Fields:\r\n//   - id: string (required, immutable) - User's Firebase Auth UID\r\n//   - role: string (required, immutable) - 'customer' | 'builder' | 'administrator'\r\n//   - full_name: string (required, 2-100 chars) - User's full name\r\n//   - phone: string (optional, nullable) - User's phone number\r\n//   - avatar_path: string (optional, nullable) - Storage path to avatar\r\n//   - district: string (optional, nullable) - User's district\r\n//   - created_at: timestamp (required, immutable) - Creation time\r\n//   - updated_at: timestamp (required) - Last update time\r\n//\r\n// Collection: builders\r\n// Document ID: auto-generated\r\n// Fields:\r\n//   - profile_id: string (required, immutable) - Reference to profiles.id\r\n//   - business_name: string (optional, nullable, 2-100 chars)\r\n//   - bio: string (optional, nullable, max 1000 chars)\r\n//   - years_experience: number (required, >= 0)\r\n//   - verification_status: string (required) - 'pending' | 'verified' | 'rejected'\r\n//   - average_rating: number (required, 0-5)\r\n//   - completed_jobs: number (required, >= 0)\r\n//   - response_time_minutes: number (optional, nullable, >= 0)\r\n//\r\n// Collection: categories\r\n// Document ID: auto-generated\r\n// Fields:\r\n//   - id: string (required, immutable)\r\n//   - name: string (required, 2-100 chars)\r\n//   - slug: string (required, 2-100 chars)\r\n//   - icon: string (optional, nullable)\r\n//\r\n// Collection: skills\r\n// Document ID: auto-generated\r\n// Fields:\r\n//   - id: string (required, immutable)\r\n//   - category_id: string (optional, nullable) - Reference to categories.id\r\n//   - name: string (required, 2-100 chars)\r\n//\r\n// Collection: builder_skills\r\n// Document ID: auto-generated\r\n// Fields:\r\n//   - builder_id: string (required, immutable) - Reference to builders.profile_id\r\n//   - skill_id: string (required, immutable) - Reference to skills.id\r\n//\r\n// Collection: portfolio_items\r\n// Document ID: auto-generated\r\n// Fields:\r\n//   - id: string (required, immutable)\r\n//   - builder_id: string (required, immutable) - Reference to builders.profile_id\r\n//   - storage_path: string (required, valid URL path)\r\n//   - caption: string (optional, nullable, max 500 chars)\r\n//   - created_at: timestamp (required, immutable)\r\n//\r\n// Collection: builder_documents\r\n// Document ID: auto-generated\r\n// Fields:\r\n//   - id: string (required, immutable)\r\n//   - builder_id: string (required, immutable) - Reference to builders.profile_id\r\n//   - type: string (required) - 'national_id' | 'certificate' | 'license'\r\n//   - storage_path: string (required, valid URL path)\r\n//   - review_status: string (required) - 'pending' | 'approved' | 'rejected'\r\n//   - created_at: timestamp (required, immutable)\r\n//\r\n// ===============================================================\r\n\r\n// ===============================================================\r\n// Helper Functions\r\n// ===============================================================\r\n\r\n// Check if the user is authenticated\r\nfunction isAuthenticated() {\r\n  return request.auth != null;\r\n}\r\n\r\n// Check if user owns the resource (for user-owned documents)\r\nfunction isOwner(userId) {\r\n  return isAuthenticated() && request.auth.uid == userId;\r\n}\r\n\r\n// Check if user is owner based on document's uid field\r\nfunction isDocOwner() {\r\n  return isAuthenticated() && request.auth.uid == resource.data.id;\r\n}\r\n\r\n// Verify UID hasn't been tampered with on create\r\nfunction uidUnchanged() {\r\n  return !('id' in request.resource.data) ||\r\n    request.resource.data.id == request.auth.uid;\r\n}\r\n\r\n// Ensure uid field is not modified on update\r\nfunction uidNotModified() {\r\n  return !('id' in request.resource.data) ||\r\n    request.resource.data.id == resource.data.id;\r\n}\r\n\r\n// Validate required fields exist\r\nfunction hasRequiredFields(fields) {\r\n  return request.resource.data.keys().hasAll(fields);\r\n}\r\n\r\n// Validate string length\r\nfunction validStringLength(field, minLen, maxLen) {\r\n  return request.resource.data[field] is string &&\r\n    request.resource.data[field].size() >= minLen &&\r\n    request.resource.data[field].size() <= maxLen;\r\n}\r\n\r\n// Validate URL format (must start with https:// or http://)\r\nfunction isValidUrl(url) {\r\n  return url is string &&\r\n    (url.matches(\"^https://.*\") || url.matches(\"^http://.*\"));\r\n}\r\n\r\n// Validate that a value is positive\r\nfunction isPositive(field) {\r\n  return request.resource.data[field] is number && request.resource.data[field] >= 0;\r\n}\r\n\r\n// Validate that the document contains only the allowed fields\r\nfunction hasOnlyAllowedFields(fields) {\r\n  return request.resource.data.keys().hasOnly(fields);\r\n}\r\n\r\n// Validate that the document hasn't changed in the fields that are not allowed to be changed\r\nfunction areImmutableFieldsUnchanged(fields) {\r\n  return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);\r\n}\r\n\r\n// Validate optional string (if present, must be string and within length)\r\nfunction isValidOptionalString(field, minLen, maxLen) {\r\n  return !(field in request.resource.data) ||\r\n         request.resource.data[field] == null ||\r\n         (request.resource.data[field] is string &&\r\n          request.resource.data[field].size() >= minLen &&\r\n          request.resource.data[field].size() <= maxLen);\r\n}\r\n\r\n// Validate that a timestamp is a valid timestamp\r\nfunction isValidTimestamp(field) {\r\n  return request.resource.data[field] is timestamp;\r\n}\r\n\r\n// ===============================================================\r\n// Domain Validators\r\n// ===============================================================\r\n\r\n// Validate profile document\r\nfunction isValidProfile(data) {\r\n  return hasOnlyAllowedFields(['id', 'role', 'full_name', 'phone', 'avatar_path', 'district', 'created_at', 'updated_at']) &&\r\n    data.id is string && data.id.size() > 0 && data.id.size() < 128 &&\r\n    data.role in ['customer', 'builder', 'administrator'] &&\r\n    validStringLength('full_name', 2, 100) &&\r\n    isValidOptionalString('phone', 7, 20) &&\r\n    isValidOptionalString('avatar_path', 1, 500) &&\r\n    isValidOptionalString('district', 1, 100) &&\r\n    isValidTimestamp('created_at') &&\r\n    isValidTimestamp('updated_at');\r\n}\r\n\r\n// Validate builder document\r\nfunction isValidBuilder(data) {\r\n  return hasOnlyAllowedFields(['profile_id', 'business_name', 'bio', 'years_experience', 'verification_status', 'average_rating', 'completed_jobs', 'response_time_minutes']) &&\r\n    data.profile_id is string && data.profile_id.size() > 0 && data.profile_id.size() < 128 &&\r\n    isValidOptionalString('business_name', 2, 100) &&\r\n    isValidOptionalString('bio', 1, 1000) &&\r\n    isPositive('years_experience') &&\r\n    data.verification_status in ['pending', 'verified', 'rejected'] &&\r\n    data.average_rating is number && data.average_rating >= 0 && data.average_rating <= 5 &&\r\n    isPositive('completed_jobs') &&\r\n    (data.response_time_minutes == null || (data.response_time_minutes is number && data.response_time_minutes >= 0));\r\n}\r\n\r\n// Validate category document\r\nfunction isValidCategory(data) {\r\n  return hasOnlyAllowedFields(['id', 'name', 'slug', 'icon']) &&\r\n    data.id is string && data.id.size() > 0 && data.id.size() < 128 &&\r\n    validStringLength('name', 2, 100) &&\r\n    validStringLength('slug', 2, 100) &&\r\n    isValidOptionalString('icon', 1, 500);\r\n}\r\n\r\n// Validate skill document\r\nfunction isValidSkill(data) {\r\n  return hasOnlyAllowedFields(['id', 'category_id', 'name']) &&\r\n    data.id is string && data.id.size() > 0 && data.id.size() < 128 &&\r\n    isValidOptionalString('category_id', 1, 128) &&\r\n    validStringLength('name', 2, 100);\r\n}\r\n\r\n// Validate builder_skill document\r\nfunction isValidBuilderSkill(data) {\r\n  return hasOnlyAllowedFields(['builder_id', 'skill_id']) &&\r\n    data.builder_id is string && data.builder_id.size() > 0 && data.builder_id.size() < 128 &&\r\n    data.skill_id is string && data.skill_id.size() > 0 && data.skill_id.size() < 128;\r\n}\r\n\r\n// Validate portfolio item document\r\nfunction isValidPortfolioItem(data) {\r\n  return hasOnlyAllowedFields(['id', 'builder_id', 'storage_path', 'caption', 'created_at']) &&\r\n    data.id is string && data.id.size() > 0 && data.id.size() < 128 &&\r\n    data.builder_id is string && data.builder_id.size() > 0 && data.builder_id.size() < 128 &&\r\n    data.storage_path is string && data.storage_path.size() > 0 && data.storage_path.size() < 500 &&\r\n    isValidOptionalString('caption', 1, 500) &&\r\n    isValidTimestamp('created_at');\r\n}\r\n\r\n// Validate builder document\r\nfunction isValidBuilderDocument(data) {\r\n  return hasOnlyAllowedFields(['id', 'builder_id', 'type', 'storage_path', 'review_status', 'created_at']) &&\r\n    data.id is string && data.id.size() > 0 && data.id.size() < 128 &&\r\n    data.builder_id is string && data.builder_id.size() > 0 && data.builder_id.size() < 128 &&\r\n    data.type in ['national_id', 'certificate', 'license'] &&\r\n    data.storage_path is string && data.storage_path.size() > 0 && data.storage_path.size() < 500 &&\r\n    data.review_status in ['pending', 'approved', 'rejected'] &&\r\n    isValidTimestamp('created_at');\r\n}\r\n\r\n// Check if user is a builder (has a builder profile)\r\nfunction isBuilder() {\r\n  return isAuthenticated() &&\r\n    exists(/databases/$(database)/documents/builders/$(request.auth.uid));\r\n}\r\n\r\n// Check if user is an administrator\r\nfunction isAdmin() {\r\n  return isAuthenticated() &&\r\n    get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'administrator';\r\n}\r\n\r\n// ===============================================================\r\n// Firestore Rules\r\n// ===============================================================\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // ===========================================================\r\n    // Profiles Collection\r\n    // Users can only read/write their own profile\r\n    // ===========================================================\r\n    match /profiles/{profileId} {\r\n      allow read: if isOwner(profileId);\r\n      allow create: if isOwner(profileId) &&\r\n        isValidProfile(request.resource.data) &&\r\n        request.resource.data.id == request.auth.uid &&\r\n        request.resource.data.role in ['customer', 'builder'] &&\r\n        request.resource.data.created_at == request.time;\r\n      allow update: if isOwner(profileId) &&\r\n        isValidProfile(request.resource.data) &&\r\n        uidNotModified() &&\r\n        areImmutableFieldsUnchanged(['id', 'role', 'created_at']) &&\r\n        request.resource.data.updated_at == request.time;\r\n      allow delete: if false;\r\n    }\r\n\r\n    // ===========================================================\r\n    // Builders Collection\r\n    // Builders can read/write their own builder profile\r\n    // Public can read verified builder profiles\r\n    // ===========================================================\r\n    match /builders/{builderId} {\r\n      allow read: if isOwner(builderId) ||\r\n        (isAuthenticated() && resource.data.verification_status == 'verified');\r\n      allow create: if isOwner(builderId) &&\r\n        isValidBuilder(request.resource.data) &&\r\n        request.resource.data.profile_id == request.auth.uid &&\r\n        request.resource.data.verification_status == 'pending';\r\n      allow update: if isOwner(builderId) &&\r\n        isValidBuilder(request.resource.data) &&\r\n        request.resource.data.profile_id == resource.data.profile_id &&\r\n        areImmutableFieldsUnchanged(['profile_id', 'average_rating', 'completed_jobs']) &&\r\n        (request.resource.data.verification_status == resource.data.verification_status ||\r\n         request.resource.data.verification_status == 'pending');\r\n      allow delete: if false;\r\n    }\r\n\r\n    // ===========================================================\r\n    // Categories Collection\r\n    // Readable by all authenticated users\r\n    // Only administrators can write\r\n    // ===========================================================\r\n    match /categories/{categoryId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isAdmin() && isValidCategory(request.resource.data);\r\n      allow update: if isAdmin() && isValidCategory(request.resource.data) &&\r\n        areImmutableFieldsUnchanged(['id']);\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // ===========================================================\r\n    // Skills Collection\r\n    // Readable by all authenticated users\r\n    // Only administrators can write\r\n    // ===========================================================\r\n    match /skills/{skillId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isAdmin() && isValidSkill(request.resource.data);\r\n      allow update: if isAdmin() && isValidSkill(request.resource.data) &&\r\n        areImmutableFieldsUnchanged(['id']);\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // ===========================================================\r\n    // Builder Skills Collection\r\n    // Builders can manage their own skills\r\n    // ===========================================================\r\n    match /builder_skills/{builderSkillId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isBuilder() &&\r\n        isValidBuilderSkill(request.resource.data) &&\r\n        request.resource.data.builder_id == request.auth.uid;\r\n      allow update: if false;\r\n      allow delete: if isBuilder() &&\r\n        resource.data.builder_id == request.auth.uid;\r\n    }\r\n\r\n    // ===========================================================\r\n    // Portfolio Items Collection\r\n    // Builders can manage their own portfolio items\r\n    // ===========================================================\r\n    match /portfolio_items/{portfolioItemId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isBuilder() &&\r\n        isValidPortfolioItem(request.resource.data) &&\r\n        request.resource.data.builder_id == request.auth.uid &&\r\n        request.resource.data.created_at == request.time;\r\n      allow update: if isBuilder() &&\r\n        isValidPortfolioItem(request.resource.data) &&\r\n        request.resource.data.builder_id == resource.data.builder_id &&\r\n        areImmutableFieldsUnchanged(['id', 'builder_id', 'created_at']);\r\n      allow delete: if isBuilder() &&\r\n        resource.data.builder_id == request.auth.uid;\r\n    }\r\n\r\n    // ===========================================================\r\n    // Builder Documents Collection\r\n    // Builders can manage their own documents\r\n    // Only administrators can change review status\r\n    // ===========================================================\r\n    match /builder_documents/{builderDocumentId} {\r\n      allow read: if isOwner(resource.data.builder_id) || isAdmin();\r\n      allow create: if isBuilder() &&\r\n        isValidBuilderDocument(request.resource.data) &&\r\n        request.resource.data.builder_id == request.auth.uid &&\r\n        request.resource.data.review_status == 'pending' &&\r\n        request.resource.data.created_at == request.time;\r\n      allow update: if (isBuilder() &&\r\n        request.resource.data.builder_id == resource.data.builder_id &&\r\n        areImmutableFieldsUnchanged(['id', 'builder_id', 'type', 'storage_path', 'created_at']) &&\r\n        request.resource.data.review_status == resource.data.review_status) ||\r\n        (isAdmin() &&\r\n        isValidBuilderDocument(request.resource.data) &&\r\n        areImmutableFieldsUnchanged(['id', 'builder_id', 'type', 'storage_path', 'created_at']));\r\n      allow delete: if isBuilder() &&\r\n        resource.data.builder_id == request.auth.uid;\r\n    }\r\n  }\r\n}","name":"firestore.rules"}]},"createTime":"2026-08-03T12:25:40.447251Z","metadata":{"services":["cloud.firestore"]},"attachmentPoint":"firestore.googleapis.com/projects/505701030512/databases/builderlink"}
