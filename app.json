{
  "expo": {
    "name": "BuilderLink Malawi",
    "slug": "builderlink-malawi",
    "scheme": "builderlink",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "BuilderLink uses your photos so you can show your work, upload your ID for verification and share photos in chat.",
          "cameraPermission": "BuilderLink uses your camera so you can take photos of a job to share in chat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "mw.builderlink.app",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "mw.builderlink.app"
    }
  }
}
